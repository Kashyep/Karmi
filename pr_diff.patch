+      final assistantHistory = buildHistoryFromEntries(assistantStraddling);
+      expect(assistantHistory[1].role, 'assistant');
+      expect(assistantHistory[1].content.length, 7999);
+      expect(assistantHistory[1].content, 'a' * 7999);
+    },
