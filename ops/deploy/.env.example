# Copy to ops/deploy/.env (ignored). Never commit real values.
DAILY_AGENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB
DAILY_AGENT_REDIS_URL=redis://redis:6379/0
DAILY_AGENT_AUTH_SECRET=generate-with-openssl-rand-hex-32
DAILY_AGENT_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
DAILY_AGENT_CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
DAILY_AGENT_CLERK_JWT_PUBLIC_KEY_B64=base64-of-clerk-jwt-public-key-pem
DAILY_AGENT_OPENROUTER_API_KEY=sk-or-...
DAILY_AGENT_PRODUCTION_PERIOD_BUDGET_MICRO=1000000
DAILY_AGENT_GLOBAL_DAILY_BUDGET_MICRO=1000000
