# Template for DAILY_AGENT_* settings (src/daily_agent/config.py). Copy to .env for local
# development only. Never put real values in this file. Placeholders below are obviously fake.
#
# Where real values live:
#   .env            local dev, written by scripts/setup_backend.py (ignored, owner-only)
#   .env.clerk      local Clerk values, written by scripts/setup_clerk.py (ignored)
#   .env.opencode   local OpenCode key, written by scripts/setup_opencode.py (ignored)
#   .env.neon       local Neon URLs. NOT auto-loaded; inject it explicitly for a local run.
#   Production      Azure Container Apps secrets, referenced by secretref env vars.
#
# Lines marked "# optional" are commented out on purpose: an empty value would not parse
# for int/None settings. Uncomment and fill in only when needed.

# ---- Core (non-secret) -------------------------------------------------------------------
# development | test | production. Anything outside development/test fails closed.
DAILY_AGENT_ENVIRONMENT=development
# Development default is local SQLite. Production requires PostgreSQL.
DAILY_AGENT_DATABASE_URL=sqlite+pysqlite:///./data/development.db
# Local data directory for SQLite-backed runs.
DAILY_AGENT_DATA_DIR=data

# ---- Database pool (non-secret) ----------------------------------------------------------
# Runtime uses the POOLED Neon URL. Keep these small.
DAILY_AGENT_DATABASE_POOL_SIZE=2
DAILY_AGENT_DATABASE_MAX_OVERFLOW=0
DAILY_AGENT_DATABASE_POOL_TIMEOUT=15
DAILY_AGENT_DATABASE_CONNECT_TIMEOUT=15
# optional, SECRET (URL with password). Migrations need the DIRECT URL; a *-pooler host is refused.
# Local: .env or explicit injection. Production: Azure Container Apps secret.
# DAILY_AGENT_MIGRATION_DATABASE_URL=postgresql+psycopg://<user>:<password>@<direct-host>/<db>?sslmode=require
# optional, SECRET if it contains credentials. Redis is not required; the SQL outbox is used.
# DAILY_AGENT_REDIS_URL=redis://<user>:<password>@<host>:6379/0

# ---- Authentication secrets (SECRET) -----------------------------------------------------
# Development placeholders only. Production needs separate values of at least 32 characters,
# and must not contain placeholder markers. Generate with a CSPRNG (64 hex chars is typical).
# Local: .env (generated by setup_backend.py). Production: Azure Container Apps secret.
DAILY_AGENT_AUTH_SECRET=replace-for-any-shared-environment
DAILY_AGENT_WEBHOOK_SECRET=replace-for-any-shared-environment
# Development token flow (/dev/token). Must be false in production.
DAILY_AGENT_ALLOW_DEVELOPMENT_AUTH=true

# ---- Clerk verification (issuer and JWT key must be set together) ------------------------
# optional, non-secret publishable key, saved in .env.clerk (Flutter uses it; backend does not).
# DAILY_AGENT_CLERK_PUBLISHABLE_KEY=pk_test_<set-in-clerk-env-file>
# optional, non-secret HTTPS Frontend API issuer. Local: .env.clerk. Production: container config.
# DAILY_AGENT_CLERK_ISSUER=https://<clerk-frontend-api-host>
# optional, base64 of the Clerk RSA PEM public key. Public, but kept with the Clerk values.
# Local: .env.clerk. Production: Azure Container Apps secret.
# DAILY_AGENT_CLERK_JWT_PUBLIC_KEY_B64=<base64-of-clerk-rsa-public-pem>

# ---- Feature gates (keep OFF unless explicitly approved) ---------------------------------
DAILY_AGENT_LIVE_MODELS_ENABLED=false
DAILY_AGENT_PAID_CHECKOUT_ENABLED=false
# Must stay false: Settings rejects WhatsApp for the current release.
DAILY_AGENT_WHATSAPP_ENABLED=false

# ---- OpenCode (off by default) -----------------------------------------------------------
DAILY_AGENT_OPENCODE_ENABLED=false
# optional, SECRET. Local: .env.opencode (scripts/setup_opencode.py). Production: Azure secret.
# DAILY_AGENT_OPENCODE_API_KEY=<set-in-host-secret-store>
# optional. Required when OPENCODE_ENABLED=true; must be in PRIVATE_DATA_MODEL_IDS
# (src/daily_agent/opencode.py).
# DAILY_AGENT_OPENCODE_MODEL_ID=<model-id-from-PRIVATE_DATA_MODEL_IDS>

# ---- Budgets (micro-units; integers) -----------------------------------------------------
# optional. Required and finite before paid checkout, live models, or OpenCode run in production.
# DAILY_AGENT_PRODUCTION_PERIOD_BUDGET_MICRO=<approved-finite-micro-budget>
DAILY_AGENT_GLOBAL_DAILY_BUDGET_MICRO=100000

# ---- Parakh policy-bundle signing keys (non-secret) --------------------------------------
# JSON list of hex Ed25519 public keys. Empty list: no bundles are accepted.
DAILY_AGENT_PARAKH_TRUSTED_PUBLIC_KEYS=[]
