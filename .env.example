# Development defaults only. Never copy synthetic limits into a paid launch without approval.
DAILY_AGENT_ENVIRONMENT=development
DAILY_AGENT_DATABASE_URL=sqlite+pysqlite:///./data/development.db
DAILY_AGENT_REDIS_URL=
DAILY_AGENT_AUTH_SECRET=replace-for-any-shared-environment
DAILY_AGENT_WEBHOOK_SECRET=replace-for-any-shared-environment
DAILY_AGENT_ALLOW_DEVELOPMENT_AUTH=true
DAILY_AGENT_LIVE_MODELS_ENABLED=false
DAILY_AGENT_PAID_CHECKOUT_ENABLED=false
DAILY_AGENT_WHATSAPP_ENABLED=false
DAILY_AGENT_PRODUCTION_PERIOD_BUDGET_MICRO=
DAILY_AGENT_GLOBAL_DAILY_BUDGET_MICRO=100000

# Routing stays static until signed bundle evaluation and operator approval.
DAILY_AGENT_ROUTER_MODE=static
DAILY_AGENT_ROUTER_POLICY_DIR=data/router_policies
# Raw Ed25519 public key as base64; never place the private key here.
DAILY_AGENT_ROUTER_POLICY_PUBLIC_KEY=
DAILY_AGENT_ROUTER_CANARY_PERCENT=0
DAILY_AGENT_ROUTER_EXPLORATION_ENABLED=false
DAILY_AGENT_ROUTER_MAX_EXPLORATION_RATE=0
DAILY_AGENT_ROUTER_EXPLORATION_TIERS=[]
DAILY_AGENT_ROUTER_EXPLORATION_DOMAINS=[]
DAILY_AGENT_ROUTER_EXPLORATION_MAX_COST_MICRO=0
DAILY_AGENT_ROUTER_DISABLED_MODELS=[]
DAILY_AGENT_ROUTER_RELOAD_INTERVAL_SECONDS=5
DAILY_AGENT_ROUTER_CIRCUIT_FAILURE_THRESHOLD=5
DAILY_AGENT_ROUTER_CIRCUIT_COOLDOWN_SECONDS=30
DAILY_AGENT_ROUTER_GUARDRAILS_ENABLED=true
DAILY_AGENT_ROUTER_GUARDRAIL_MIN_SAMPLES=50
DAILY_AGENT_ROUTER_GUARDRAIL_WINDOW=200
DAILY_AGENT_ROUTER_GUARDRAIL_MAX_FAILURE_RATE=0.2
DAILY_AGENT_ROUTER_GUARDRAIL_MAX_FALLBACK_RATE=0.2
DAILY_AGENT_ROUTER_GUARDRAIL_MAX_MEAN_COST_MICRO=
DAILY_AGENT_ROUTER_GUARDRAIL_MAX_P95_LATENCY_MS=

# Non-blocking telemetry; protect spool/export directories as customer data.
DAILY_AGENT_TELEMETRY_ENABLED=true
DAILY_AGENT_TELEMETRY_QUEUE_SIZE=10000
DAILY_AGENT_TELEMETRY_BATCH_SIZE=200
DAILY_AGENT_TELEMETRY_FLUSH_INTERVAL_SECONDS=1
DAILY_AGENT_TELEMETRY_SPOOL_PATH=data/telemetry-spool.jsonl
DAILY_AGENT_TELEMETRY_EXPORT_DIR=data/telemetry-exports
DAILY_AGENT_TELEMETRY_ATTRIBUTION_WINDOW_SECONDS=86400
DAILY_AGENT_TELEMETRY_RETENTION_DAYS=90
DAILY_AGENT_TELEMETRY_STORE_CORRECTION_TEXT=false

