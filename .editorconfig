root = true

# Defaults for every file. Matches the existing tree: LF line endings, UTF-8, final newlines.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing double spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Python: 4-space indent; max_line_length mirrors [tool.ruff] line-length = 100 in pyproject.toml.
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# Dart, YAML and JSON: 2-space indent (dart format default; existing files use 2 spaces).
[*.{dart,yaml,yml,json}]
indent_style = space
indent_size = 2

# Makefile recipes require literal tabs.
[Makefile]
indent_style = tab
